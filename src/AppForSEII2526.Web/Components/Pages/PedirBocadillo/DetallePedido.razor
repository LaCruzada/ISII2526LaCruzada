@page "/PedirBocadillo/DetallePedido"

@using AppForSEII2526.API.DTOs.DTOsPedirBocadillo
@inject NavigationManager NavManager
@inject AppForSEII2526.Web.API.AppForSEII2526APICLIENT ApiClient

<h3>Detalles del Pedido</h3>

<div class="container-fluid">
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @error
            <br />
            <button class="btn btn-sm btn-outline-danger mt-2" @onclick="Volver">Volver</button>
        </div>
    }
    else if (pedido == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Conectando con la base de datos...</p>
        </div>
    }
    else
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">Información General</div>
            <div class="card-body">
                <table class="table table-borderless table-sm">
                    <tr>
                        <th style="width: 200px;">Nº Pedido:</th>
                        <td>#@pedido.PedidoId</td>
                    </tr>
                    <tr>
                        <th>Cliente:</th>
                        <td id="detalleNombreCliente">@pedido.NombreCliente</td>
                    </tr>
                    <tr>
                        <th>Fecha Compra:</th>
                        <td>@pedido.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <th>Método Pago:</th>
                        <td>@pedido.MetodoPago</td>
                    </tr>
                </table>
            </div>
        </div>
        <h4>Bocadillos Comprados</h4>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Bocadillo</th>
                        <th>Pan</th>
                        <th>Precio Unit.</th>
                        <th>Cantidad</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in pedido.Bocadillos)
                    {
                        <tr>
                            <td>@item.NombreBocadillo</td>
                            <td>@item.TipoPan</td>
                            <td>@item.PrecioUnitario.ToString("C")</td>
                            <td>@item.Cantidad</td>
                            <td class="text-end">
                                @((item.PrecioUnitario * item.Cantidad).ToString("C"))
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold fs-5">
                        <td colspan="4" class="text-end">Precio Total:</td>
                        <td class="text-end text-primary">@pedido.PrecioTotal.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="mt-3">
            <button class="btn btn-secondary" @onclick="Volver">Volver al Listado</button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int Id { get; set; }

    private PedidoBocadilloDetailsDTO? pedido;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        if (Id <= 0)
        {
            error = "Error: No se ha especificado un ID de pedido válido.";
            return;
        }

        try
        {
            var pedidoGenerado = await ApiClient.GetPedidoAsync(Id);
            if (pedidoGenerado != null)
            {
                pedido = new PedidoBocadilloDetailsDTO
                {
                    PedidoId = pedidoGenerado.PedidoId,
                    NombreCliente = pedidoGenerado.NombreCliente,
                    FechaCompra = pedidoGenerado.FechaCompra.DateTime,
                    MetodoPago = pedidoGenerado.MetodoPago,
                    PrecioTotal = (decimal)pedidoGenerado.PrecioTotal,
                    Bocadillos = new List<BocadilloItemDTO>()
                };

                foreach (var item in pedidoGenerado.Bocadillos)
                {
                    pedido.Bocadillos.Add(new BocadilloItemDTO
                    {
                        BocadilloId = item.BocadilloId,
                        NombreBocadillo = item.NombreBocadillo,
                        TipoPan = item.TipoPan,
                        Cantidad = item.Cantidad,
                        PrecioUnitario = (decimal)item.PrecioUnitario
                    });
                }
            }
        }
        catch (Exception ex)
        {
            error = "No se pudo cargar el pedido. Verifica que la API está encendida. " + ex.Message;
            pedido = null;
        }
    }
    private void Volver() => NavManager.NavigateTo("/PedirBocadillo/SeleccionarPedirBocadillo");
}