@page "/PedirBocadillo/SeleccionarPedirBocadillo"

@using AppForSEII2526.Web.Services

@inject ILogger<SeleccionarPedirBocadillo> Logger
@inject PedirBocadilloStateContainer StateContainer
@inject NavigationManager NavManager
@inject AppForSEII2526.Web.API.AppForSEII2526APICLIENT ApiClient

<h3>Seleccionar Bocadillos</h3>

<div class="container-fluid">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    <div class="row">
        <div class="col-8">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Tamaño:</label>
                            <select class="form-select" @bind="filtroTamano">
                                <option value="All">Todos</option>
                                <option value="Normal">Normal</option>
                                <option value="Pequeño">Pequeño</option>
                                <option value="Grande">Grande</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nombre (Filtro local):</label>
                            <input type="text" class="form-control" @bind="filtroNombre" placeholder="Ej: Vegetal" />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary w-100" @onclick="AplicarFiltros">Buscar</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                @if (BocadillosMostrados == null)
                {
                    <div class="text-center p-3">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p>Cargando datos reales...</p>
                    </div>
                }
                else
                {
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Pan</th>
                                <th>Tamaño</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bocata in BocadillosMostrados)
                            {
                                <tr>
                                    <td>@bocata.Nombre</td>
                                    <td>@bocata.TipoPan</td>
                                    <td>@bocata.Tamano</td>
                                    <td>@bocata.Precio.ToString("0.00") €</td>
                                    <td>@bocata.Stock</td>
                                    <td>
                                        <button class="btn btn-outline-success btn-sm"
                                                @onclick="@(() => AddBocadillo(bocata))"
                                                disabled="@(bocata.Stock <= 0)">
                                            Añadir
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!BocadillosMostrados.Any())
                    {
                        <div class="alert alert-warning">No se encontraron bocadillos.</div>
                    }
                }
            </div>
        </div>
        <div class="col-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    Cesta (@StateContainer.Pedido.Bocadillos.Count)
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in StateContainer.CarritoVisual)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@item.Nombre</strong><br />
                                    <small>@item.Tamano</small>
                                </div>
                                <span>@item.Precio €</span>
                                <button class="btn btn-danger btn-sm ms-2" @onclick="() => RemoveBocadilloItem(item)">X</button>
                            </li>
                        }
                        @if (!StateContainer.CarritoVisual.Any())
                        {
                            <li class="list-group-item text-center text-muted">Vacío</li>
                        }
                    </ul>
                </div>
                <div class="card-footer">
                    <h5>Total: @StateContainer.PrecioTotal.ToString("0.00") €</h5>
                    <button class="btn btn-warning w-100" @onclick="ComprarBocadillos" disabled="@(!StateContainer.CarritoVisual.Any())">
                        Tramitar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ICollection<AppForSEII2526.API.DTOs.DTOsPedirBocadillo.BocadilloSelectDTO>? BocadillosMostrados;
    private string filtroTamano = "All";
    private string filtroNombre = "";
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        StateContainer.OnChange += StateHasChanged;
        await CargarBocadillosReales();
    }

    private async Task CargarBocadillosReales()
    {
        try
        {
            errorMessage = null;
            string? tamanoEnvio = (filtroTamano == "All") ? null : filtroTamano;
            var resultadoApi = await ApiClient.GetBocadillosDisponiblesAsync(tamanoEnvio, null);
            BocadillosMostrados = new List<AppForSEII2526.API.DTOs.DTOsPedirBocadillo.BocadilloSelectDTO>();

            if (resultadoApi != null)
            {
                var listaFiltrada = string.IsNullOrWhiteSpace(filtroNombre)
                    ? resultadoApi
                    : resultadoApi.Where(b => b.Nombre != null && b.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase));

                foreach (var itemGenerado in listaFiltrada)
                {
                    var miBocata = new AppForSEII2526.API.DTOs.DTOsPedirBocadillo.BocadilloSelectDTO
                    {
                        Id = itemGenerado.Id,
                        Nombre = itemGenerado.Nombre,
                        TipoPan = itemGenerado.TipoPan,
                        Tamano = itemGenerado.Tamano,
                        Precio = (decimal)itemGenerado.Precio,
                        Stock = itemGenerado.Stock
                    };
                    BocadillosMostrados.Add(miBocata);
                }
            }
        }
        catch (Exception ex)
        {
            BocadillosMostrados = new List<AppForSEII2526.API.DTOs.DTOsPedirBocadillo.BocadilloSelectDTO>();
            errorMessage = "Error de conexión: " + ex.Message;
        }
    }

    private async Task AplicarFiltros() => await CargarBocadillosReales();

    private void AddBocadillo(AppForSEII2526.API.DTOs.DTOsPedirBocadillo.BocadilloSelectDTO b) => StateContainer.AgregarBocadillo(b);

    private void RemoveBocadilloItem(AppForSEII2526.API.DTOs.DTOsPedirBocadillo.BocadilloSelectDTO b) => StateContainer.EliminarBocadillo(b);

    public void Dispose() => StateContainer.OnChange -= StateHasChanged;

    private void ComprarBocadillos() => NavManager.NavigateTo("/PedirBocadillo/Create");
}