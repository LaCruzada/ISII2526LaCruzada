@page "/Resenya/Select"
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Services
@using AppForSEII2526.Web.Components
@implements IDisposable

@inject ILogger<SeleccionarBocadillosResenya> logger
@inject StateContainerCrearResenya StateContainer
@inject NavigationManager navigation
@inject AppForSEII2526APICLIENT ApiClient

<h3>Seleccionar Bocadillos para la Reseña</h3>

<div class="container-fluid">
    <div class="row">
        <div class="col-8">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Nombre (Buscar):</label>
                            <input type="text" class="form-control" @bind="filtroNombre" placeholder="Ej: Vegetal" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Precio mínimo (PVP):</label>
                            <input type="number" class="form-control" @bind="filtroPVPMin" min="0" step="0.01" placeholder="Ej: 2,00" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Precio máximo (PVP):</label>
                            <input type="number" class="form-control" @bind="filtroPVPMax" min="0" step="0.01" placeholder="Ej: 10,00" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" @onclick="BuscarBocadillos">
                                Buscar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                @if (isLoading)
                {
                    <div class="text-center p-3">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p>Cargando bocadillos...</p>
                    </div>
                }
                else if (BocadillosMostrados == null || !BocadillosMostrados.Any())
                {
                    <div class="alert alert-warning">No hay bocadillos que coincidan.</div>
                }
                else
                {
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Tipo Pan</th>
                                <th>Tamaño</th>
                                <th>Precio</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bocadillo in BocadillosMostrados)
                            {
                                <tr>
                                    <td>@bocadillo.Nombre</td>
                                    <td>@bocadillo.TipoPanId</td>
                                    <td>@bocadillo.Tamano</td>
                                    <td>@bocadillo.PVP.ToString("0.00") €</td>
                                    <td>
                                        <button class="btn btn-outline-success btn-sm"
                                                @onclick="@(() => AddBocadillo(bocadillo))">
                                            Añadir
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="col-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    Bocadillos Seleccionados (@StateContainer.Resenya.ResenyaBocadillos.Count)
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (AppForSEII2526.Web.API.ResenyaBocadilloDTO item in StateContainer.Resenya.ResenyaBocadillos)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@item.Nombre</strong><br />
                                    <small>@item.Tamano</small>
                                </div>
                                <span>@item.Pvp.ToString("0.00") €</span>
                                <button class="btn btn-danger btn-sm ms-2" @onclick="() => RemoveBocadillo(item)">X</button>
                            </li>
                        }
                        @if (!StateContainer.Resenya.ResenyaBocadillos.Any())
                        {
                            <li class="list-group-item text-center text-muted">Vacío</li>
                        }
                    </ul>
                </div>
            </div>
            <button id="CrearResenya" class="btn btn-success mt-3 w-100"
                    @onclick="CrearResenya"
                    disabled="@(!StateContainer.Resenya.ResenyaBocadillos.Any())">
                Crear reseña
            </button>

        </div>
    </div>
</div>

@code {
    private List<AppForSEII2526.API.DTOs.DTOsCrearResenya.BocadillosDTOs.BocadilloSeleccionadoDTO> TodosLosBocadillos = new List<AppForSEII2526.API.DTOs.DTOsCrearResenya.BocadillosDTOs.BocadilloSeleccionadoDTO>();
    private ICollection<AppForSEII2526.API.DTOs.DTOsCrearResenya.BocadillosDTOs.BocadilloSeleccionadoDTO>? BocadillosMostrados;
    private string filtroNombre = "";
    private double? filtroPVPMin = null;
    private double? filtroPVPMax = null;
    private bool isLoading = false;

    protected override void OnInitialized()
    {
        StateContainer.OnChange += StateHasChanged;
        BuscarBocadillos();
    }

    private async void BuscarBocadillos()
    {
        string? nombreFiltro = string.IsNullOrWhiteSpace(filtroNombre) ? null : filtroNombre;
        double? minFiltro = filtroPVPMin.HasValue && filtroPVPMin.Value > 0 ? filtroPVPMin : null;
        double? maxFiltro = filtroPVPMax.HasValue && filtroPVPMax.Value > 0 ? filtroPVPMax : null;
        isLoading = true;
        try
        {
            var bocadillosAPI = await ApiClient.GetBocadillosParaResenyaAsync(nombreFiltro, minFiltro, maxFiltro);

            TodosLosBocadillos = bocadillosAPI.Select(b => new AppForSEII2526.API.DTOs.DTOsCrearResenya.BocadillosDTOs.BocadilloSeleccionadoDTO
            {
                Id = b.Id,
                Nombre = b.Nombre,
                TipoPanId = b.TipoPanId,
                PVP= (decimal)b.Pvp,
                Tamano = (AppForSEII2526.API.Models.EnumTamaño)b.Tamano,

            }).ToList();
            BocadillosMostrados = TodosLosBocadillos;
        }
        catch (Exception ex)
        {
            TodosLosBocadillos = new List<AppForSEII2526.API.DTOs.DTOsCrearResenya.BocadillosDTOs.BocadilloSeleccionadoDTO>();
            BocadillosMostrados = TodosLosBocadillos;
            logger.LogError(ex, "Error al cargar bocadillos desde la API");
        }
        finally
        {
            isLoading = false;
        }
        StateHasChanged();
    }

    private void AddBocadillo(AppForSEII2526.API.DTOs.DTOsCrearResenya.BocadillosDTOs.BocadilloSeleccionadoDTO bocadillo)
    {
        StateContainer.AgregarBocadilloParaResenya(bocadillo);
    }

    private void RemoveBocadillo(ResenyaBocadilloDTO item)
    {
        var bocadilloSelect = TodosLosBocadillos.FirstOrDefault(b => b.Id == item.BocadilloId);
        if (bocadilloSelect != null)
        {
            StateContainer.EliminarBocadilloParaResenya(bocadilloSelect);
        }
    }

    private void CrearResenya()
    {
        navigation.NavigateTo("/Resenya/Create");
    }

    public void Dispose()
    {
        StateContainer.OnChange -= StateHasChanged;
    }
}
