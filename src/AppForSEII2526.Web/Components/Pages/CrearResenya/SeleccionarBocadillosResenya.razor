@page "/Resenya/Select"
@using AppForSEII2526.API.DTOs.DTOsCrearResenya.BocadillosDTOs
@using AppForSEII2526.API.Models
@using AppForSEII2526.Web.StateContainers
@inject ILogger<SeleccionarBocadillosResenya> Logger
@inject StateContainerCrearResenya StateContainer
@inject NavigationManager NavManager

<h3>Seleccionar Bocadillos para la Reseña</h3>

<div class="container-fluid">
    <div class="row">
        <div class="col-8">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Nombre (Buscar):</label>
                            <input type="text" class="form-control" @bind="filtroNombre" placeholder="Ej: Vegetal" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Precio mínimo (PVP):</label>
                            <input type="number" class="form-control" @bind="filtroPVPMin" min="0" step="0.01" placeholder="Ej: 2,00" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Precio máximo (PVP):</label>
                            <input type="number" class="form-control" @bind="filtroPVPMax" min="0" step="0.01" placeholder="Ej: 10,00" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" @onclick="AplicarFiltros">
                                Buscar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo Pan</th>
                            <th>Tamaño</th>
                            <th>Precio</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bocadillo in BocadillosMostrados)
                        {
                            <tr>
                                <td>@bocadillo.Nombre</td>
                                <td>@bocadillo.TipoPanId</td>
                                <td>@bocadillo.Tamano</td>
                                <td>@bocadillo.PVP.ToString("0.00") €</td>
                                <td>
                                    <button class="btn btn-outline-success btn-sm"
                                            @onclick="@(() => AddBocadillo(bocadillo))">
                                        Añadir
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!BocadillosMostrados.Any())
                {
                    <div class="alert alert-warning">No hay bocadillos que coincidan.</div>
                }
            </div>
        </div>

        <div class="col-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    Bocadillos Seleccionados (@StateContainer.Resenya.ResenyaBocadillos.Count)
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in StateContainer.Resenya.ResenyaBocadillos)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@item.Nombre</strong><br />
                                    <small>@item.Tamano</small>
                                </div>
                                <span>@item.PVP.ToString("0.00") €</span>
                                <button class="btn btn-danger btn-sm ms-2" @onclick="() => RemoveBocadillo(item)">X</button>
                            </li>
                        }
                        @if (!StateContainer.Resenya.ResenyaBocadillos.Any())
                        {
                            <li class="list-group-item text-center text-muted">Vacío</li>
                        }
                    </ul>
                </div>
            </div>
            <button class="btn btn-success mt-3 w-100"
                    @onclick="CrearResenya"
                    disabled="@(!StateContainer.Resenya.ResenyaBocadillos.Any())">
                Crear reseña
            </button>
        </div>
    </div>
</div>

@code {
    private List<BocadilloSeleccionadoDTO> TodosLosBocadillos = new List<BocadilloSeleccionadoDTO>();
    private List<BocadilloSeleccionadoDTO> BocadillosMostrados = new List<BocadilloSeleccionadoDTO>();
    private string filtroNombre = "";
    private decimal? filtroPVPMin = null;
    private decimal? filtroPVPMax = null;

    protected override void OnInitialized()
    {
        StateContainer.OnChange += StateHasChanged;

        // Mock de datos, reemplaza por llamada a API si es necesario
        TodosLosBocadillos = new List<BocadilloSeleccionadoDTO>
        {
            new BocadilloSeleccionadoDTO(1, "Vegetal", 3.50m, EnumTamaño.Normal, 1),
            new BocadilloSeleccionadoDTO(2, "Jamón", 4.00m, EnumTamaño.Normal, 2),
            new BocadilloSeleccionadoDTO(3, "Tortilla", 2.50m, EnumTamaño.Pequeño, 1)
        };

        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        var resultado = TodosLosBocadillos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtroNombre))
        {
            resultado = resultado.Where(b => b.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase));
        }

        if (filtroPVPMin.HasValue && filtroPVPMin.Value > 0)
        {
            resultado = resultado.Where(b => b.PVP >= filtroPVPMin.Value);
        }

        if (filtroPVPMax.HasValue && filtroPVPMax.Value > 0)
        {
            resultado = resultado.Where(b => b.PVP <= filtroPVPMax.Value);
        }

        BocadillosMostrados = resultado.ToList();
    }

    private void AddBocadillo(BocadilloSeleccionadoDTO bocadillo)
    {
        StateContainer.AgregarBocadilloParaResenya(bocadillo);
    }

    private void RemoveBocadillo(ResenyaBocadilloDTO bocadillo)
    {
        StateContainer.EliminarBocadilloParaResenya(bocadillo);
    }

    private void CrearResenya()
    {
        NavManager.NavigateTo("/Resenya/Create");
    }

    public void Dispose()
    {
        StateContainer.OnChange -= StateHasChanged;
    }
}
