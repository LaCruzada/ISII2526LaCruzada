@page "/Resenya/Create"
@using AppForSEII2526.Web.Services
@using AppForSEII2526.Web.Components.Layout
@using AppForSEII2526.Web.API
@inject NavigationManager NavManager
@inject StateContainerCrearResenya StateContainer
@inject ILogger<CreateResenya> Logger
@inject AppForSEII2526APICLIENT apiclient

<h3>Publicar Reseña</h3>

<div class="container-fluid">
    <!-- Datos de la reseña -->
    <div class="card mb-4">
        <div class="card-header">Datos de la Reseña</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre de usuario (opcional):</label>
                    <input class="form-control" @bind="resenya.NombreUsuario" placeholder="Ej: Caridad" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Título:</label>
                    <input class="form-control" maxlength="20" required @bind="resenya.Titulo" placeholder="Ej: Sugerencia para..." />
                    @if (!string.IsNullOrEmpty(errorTitulo))
                    {
                        <div class="text-danger small">@errorTitulo</div>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label">Valoración general:</label>
                    <select class="form-select" @bind="valoracionGeneralSeleccionada">
                        <option value="">Selecciona:</option>
                        @foreach (var valor in Enum.GetValues<EnumValoracion_General>())
                        {
                            <option value="@(1+(int)valor)">@(1+(int)valor) estrella(s)</option>
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(errorValoracion))
                    {
                        <div class="text-danger small">@errorValoracion</div>
                    }
                </div>
                <div class="col-12">
                    <label class="form-label">Descripción:</label>
                    <textarea class="form-control" maxlength="200" required @bind="resenya.Descripcion" placeholder="Escribe tu opinión..."></textarea>
                    @if (!string.IsNullOrEmpty(errorDescripcion))
                    {
                        <div class="text-danger small">@errorDescripcion</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bocadillos -->
    <div class="card mb-4">
        <div class="card-header">Bocadillos</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tamaño</th>
                            <th>Precio</th>
                            <th>Puntuación (1-10)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < resenya.ResenyaBocadillos.Count; i++)
                        {
                            var bocadillo = resenya.ResenyaBocadillos.ElementAt(i);
                            <tr>
                                <td>@bocadillo.Nombre</td>
                                <td>@bocadillo.Tamano</td>
                                <td>@bocadillo.Pvp.ToString("0.00") €</td>
                                <td>
                                    <input type="number" class="form-control" min="1" max="10" @bind="bocadillo.Puntuacion" />
                                    @if (erroresBocadillos.ContainsKey(i) && !string.IsNullOrEmpty(erroresBocadillos[i]))
                                    {
                                        <div class="text-danger small">@erroresBocadillos[i]</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Botones -->
    <div class="d-flex justify-content-between">
        <button type="button" class="btn btn-secondary" @onclick="VolverASeleccion">
            <i class="bi bi-arrow-left"></i> Modificar bocadillos
        </button>
        <button type="button" class="btn btn-success btn-lg" @onclick="ValidarYConfirmar" disabled="@(!resenya.ResenyaBocadillos.Any())">
            Publicar reseña
        </button>
    </div>
</div>

<!-- Diálogo de confirmación -->
@if (dialogoAbierto)
{
    <Dialog Caption="Confirmar publicación"
            Message="¿Estás seguro de que quieres publicar esta reseña?"
            OnClose="@AlCerrarDialogo"
            Type="Dialog.Category.SaveNot">
    </Dialog>
}

@code {
    private string mensajeError = "";
    private AppForSEII2526.Web.API.ResenyaForCreacionDTO resenya => StateContainer.Resenya;
    private bool dialogoAbierto = false;
    private string errorTitulo;
    private string errorDescripcion;
    private string errorValoracion;
    private Dictionary<int, string> erroresBocadillos = new();
    private string valoracionGeneralSeleccionada
    {
        get => resenya.ValoracionGeneral == 0 ? "" : ((int)resenya.ValoracionGeneral).ToString();
        set
        {
            if (int.TryParse(value, out int val))
                resenya.ValoracionGeneral = (EnumValoracion_General)val;
            else
                resenya.ValoracionGeneral = 0;
        }
    }

    // Variable para navegación posterior
    private int? idResenyaCreada = null;

    protected override void OnInitialized()
    {
        if (resenya.FechaPublicacion == default)
            resenya.FechaPublicacion = DateTime.Now;
    }

    private void VolverASeleccion()
    {
        NavManager.NavigateTo("/Resenya/Select");
    }

    private void ValidarYConfirmar()
    {
        errorTitulo = errorDescripcion = errorValoracion = "";
        erroresBocadillos.Clear();
        bool valido = true;

        // Validación del título obligatorio
        if (string.IsNullOrWhiteSpace(resenya.Titulo))
        {
            errorTitulo = "El título es obligatorio.";
            valido = false;
        }
        // Validación de que empiece por "Sugerencia para"
        else if (!resenya.Titulo.StartsWith("Sugerencia para"))
        {
            errorTitulo = "El título debe comenzar con 'Sugerencia para'.";
            valido = false;
        }

        // Validación de la descripción
        if (string.IsNullOrWhiteSpace(resenya.Descripcion))
        {
            errorDescripcion = "La descripción es obligatoria.";
            valido = false;
        }

        // Validación de la valoración general
        if (string.IsNullOrEmpty(valoracionGeneralSeleccionada) ||
            !int.TryParse(valoracionGeneralSeleccionada, out int val) ||
            val < (int)EnumValoracion_General.Una || val > (int)EnumValoracion_General.Cinco)
        {
            errorValoracion = "La valoración general es obligatoria.";
            valido = false;
        }

        // Validación de las puntuaciones de los bocadillos
        for (int i = 0; i < resenya.ResenyaBocadillos.Count; i++)
        {
            var bocadillo = resenya.ResenyaBocadillos.ElementAt(i);
            if (bocadillo.Puntuacion < 1 || bocadillo.Puntuacion > 10)
            {
                erroresBocadillos[i] = "La puntuación debe estar entre 1 y 10.";
                valido = false;
            }
        }

        if (valido)
        {
            dialogoAbierto = true;
        }
    }


    private async Task AlCerrarDialogo(bool aceptado)
    {
        dialogoAbierto = false;

        if (aceptado && StateContainer.Resenya.ResenyaBocadillos.Count > 0)
        {
            try
            {
                var resenyaCreada = await apiclient.CrearResenyaAsync(StateContainer.Resenya);
                StateContainer.ResenyaProcesada();
                NavManager.NavigateTo($"/Resenya/Details/?ResenyaId={resenyaCreada.Id}");

            }
            catch (ApiException<ValidationProblemDetails> validationEx)
            {
                if (validationEx.Result.Errors.Values != null)
                {
                    string mensaje = "";
                    foreach (var errors in validationEx.Result.Errors.Values)
                        mensaje = string.Join("() ", mensaje, string.Join(" () ", errors));
                    Logger.LogError("Error de validación al crear la reseña: {0}", mensaje);
                }
            }
            catch (HttpRequestException httpEx)
            {
                Logger.LogError(httpEx, "Error de conexión al intentar crear la reseña");
                mensajeError = "No se pudo conectar con el servidor. Por favor, verifica que la API esté en ejecución.";
            }
            catch (ApiException apiEx)
            {
                Logger.LogError(apiEx, "Error al procesar la creación de la reseña");
                mensajeError = "Error al procesar tu solicitud, por favor inténtalo más tarde.";
            }
        }
    }

    // Se ejecuta después del render para navegar de forma segura
    
}
