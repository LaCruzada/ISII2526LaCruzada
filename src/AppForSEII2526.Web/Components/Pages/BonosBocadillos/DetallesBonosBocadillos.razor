@page "/bonos/Detallecompra"
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Services
@inject AppForSEII2526APICLIENT apiclient
@inject NavigationManager navigation

<h3>Detalle de la Compra de Bonos</h3>

@if (compra == null)
{
    <p>@error</p>
}
else
{
    <div class="container-fluid">
        <table class="table table-borderless table-sm">
            <tr>
                <th>Nombre y Apellidos</th>
                <td id="NombreApellidos">@compra.NombreCliente @compra.ApellidoCliente1 @compra.ApellidoCliente2</td>
            </tr>
            <tr>
                <th>Método de Pago</th>
                <td id="MetodoPago">@compra.Pago</td>
            </tr>
            <tr>
                <th>Fecha de Compra</th>
                <td id="FechaCompra">@compra.FechaCompra.ToString("dd/MM/yyyy HH:mm:ss")</td>
            </tr>
        </table>

        <h4>Bonos Comprados</h4>

        <table class="table" id="BonosComprados">
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Precio Unitario</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in compra.BonoItem)
                {
                    <tr id="BonoItem_@item.Nombre">
                        <td>@item.Nombre</td>
                        <td>@item.Tipo</td>
                        <td>@item.Cantidad</td>
                        <td>@item.PrecioUnitario.ToString("F2") €</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @* colspan is used to state that THREE columns are collapsed *@
                <th scope="row" colspan="3" class="text-end">Precio Total: </th>
                <td id="PrecioTotal">@compra.PrecioTotal.ToString("F2") €</td>
            </tfoot>
        </table>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int CompraID { get; set; }

    private ComprarBonoBocadilloDetalle? compra;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            compra = await apiclient.GetCompraAsync(CompraID);
        }
        catch (ApiException exception)
        {
            compra = null;
            error = $"Error! No existe una compra con id={CompraID}";
        }
    }
}
