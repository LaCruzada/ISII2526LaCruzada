@page "/bonos/PostBonoBocadillo"
@inject NavigationManager navigation
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Services
@inject AppForSEII2526APICLIENT apiclient
@inject ILogger<PostBonosBocadillos> logger
@inject ComprarBonoStateContainer bonoState

<h3>Crear Compra de Bonos</h3>

@if (!hideErrors)
{
    <div class="alert alert-danger" role="alert">
        <p id="ErrorsShown">Errores: @messageError</p>
    </div>
}

@if (compra == null || compra.BonoItem == null || compra.BonoItem.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        <strong>Atención:</strong> No hay bonos en el carrito. <a href="/bonos/seleccionar">Volver a seleccionar bonos</a>
    </div>
}
else
{
    <EditForm Model="compra" OnValidSubmit="OpenDialog">
        <div class="row">
            <DataAnnotationsValidator />
            <ValidationSummary class="row alert alert-danger" />
        </div>

        <div class="container-fluid">
            <h4>Datos del Cliente</h4>
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="form-floating">
                        <InputText @bind-Value="compra.NombreCliente" class="form-control" id="Nombre" placeholder="Nombre" />
                        <label for="Nombre">Nombre</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <InputText @bind-Value="compra.ApellidoCliente1" class="form-control" id="Apellido1" placeholder="Primer Apellido" />
                        <label for="Apellido1">Primer Apellido</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <InputText @bind-Value="compra.ApellidoCliente2" class="form-control" id="Apellido2" placeholder="Segundo Apellido" />
                        <label for="Apellido2">Segundo Apellido</label>
                    </div>
                </div>
            </div>

            <h4>Método de Pago</h4>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        <InputSelect class="form-select" @bind-Value="compra.Pago" id="MetodoPago">
                            <option value="@MetodoPago.Tarjeta" selected>Tarjeta de Crédito/Débito</option>
                            <option value="@MetodoPago.Paypal">PayPal</option>
                            <option value="@MetodoPago.GooglePay">Google Pay</option>
                        </InputSelect>
                        <label for="MetodoPago">Método de Pago</label>
                    </div>
                </div>
            </div>

            <h4>Detalle de la Compra</h4>
            <p><b>Fecha de Compra:</b> @compra.FechaCompra.ToString("dd/MM/yyyy HH:mm:ss")</p>
            <p><b>Precio Total:</b> @CalcularPrecioTotal().ToString("F2") €</p>

            <div class="table-responsive">
                <table class="table table-hover" id="TableOfBonoItems">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in compra.BonoItem)
                        {
                            <tr id="BonoData_@item.BonoID">
                                <td>@item.Nombre</td>
                                <td>@item.Tipo</td>
                                <td>@item.Cantidad</td>
                                <td>@item.PrecioUnitario.ToString("F2") €</td>
                                <td>@((item.PrecioUnitario * item.Cantidad).ToString("F2")) €</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-active">
                            <th colspan="4" class="text-end">Precio Total:</th>
                            <th><strong>@CalcularPrecioTotal().ToString("F2") €</strong></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-outline-secondary" type="button" @onclick="ModificarBonos" id="ModificarBonos">
                    Modificar bonos
                </button>
                <button class="btn btn-primary" type="submit" id="Submit" disabled="@compraButtonDisabled">
                    Continuar con la compra
                </button>
            </div>
        </div>
    </EditForm>
}

@* Modal de confirmación *@
@if (DialogIsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Compra de Bonos</h5>
                </div>
                <div class="modal-body">
                    <p>¿Deseas proceder con la compra de los bonos seleccionados?</p>
                    @if (compra != null)
                    {
                        <p><strong>Cliente:</strong> @compra.NombreCliente @compra.ApellidoCliente1 @compra.ApellidoCliente2</p>
                        <p><strong>Método de Pago:</strong> @ObtenerNombreMetodoPago(compra.Pago)</p>
                        <p><strong>Total:</strong> @CalcularPrecioTotal().ToString("F2") €</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="@(() => OnDialogClose(false))">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="@(() => OnDialogClose(true))" id="ConfirmButton">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string messageError = "";
    private bool hideErrors => string.IsNullOrEmpty(messageError);
    private bool compraButtonDisabled => compra == null || compra.BonoItem == null || compra.BonoItem.Count == 0;
    private bool DialogIsOpen;

    private ComprarBonoBocadilloPost? compra => bonoState.Compra;

    private void ModificarBonos()
    {
        navigation.NavigateTo("/bonos/seleccionar");
    }

    private double CalcularPrecioTotal()
    {
        if (compra == null || compra.BonoItem == null || compra.BonoItem.Count == 0)
            return 0.0;

        return compra.BonoItem.Sum(item => item.PrecioUnitario * item.Cantidad);
    }

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;

        if (isOk && compra != null && compra.BonoItem != null && compra.BonoItem.Count > 0)
        {
            try
            {
                var compraCreada = await apiclient.CrearCompraAsync(compra);
                bonoState.CompraProcesada();
                navigation.NavigateTo($"/bonos/Detallecompra/?CompraId={compraCreada.CompraId}");
            }
            catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
            {
                if (apiexceptionvalidation.Result.Errors.Values != null)
                {
                    messageError = "";
                    foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                    {
                        messageError = string.Join("() ", messageError, string.Join(" () ", errors));
                    }
                }
            }
            catch (HttpRequestException httpEx)
            {
                logger.LogError(httpEx, "Error de conexión al intentar crear la compra");
                messageError = "No se pudo conectar con el servidor. Por favor, verifica que la API esté en ejecución.";
            }
            catch (ApiException)
            {
                messageError = "Error al procesar tu solicitud, por favor inténtalo más tarde.";
            }
        }
    }

    private string ObtenerNombreMetodoPago(MetodoPago metodo)
    {
        return metodo switch
        {
            MetodoPago.Tarjeta => "Tarjeta de Crédito/Débito",
            MetodoPago.Paypal => "PayPal",
            MetodoPago.GooglePay => "Google Pay",
            _ => metodo.ToString()
        };
    }
}