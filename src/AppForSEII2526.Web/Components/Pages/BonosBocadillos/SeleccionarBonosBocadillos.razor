@page "/bonos/seleccionar"
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Services
@using AppForSEII2526.Web.Components
@implements IDisposable

@inject ILogger<SeleccionarBonosBocadillos> logger
@inject ComprarBonoStateContainer bonoState
@inject NavigationManager navigation
@inject AppForSEII2526APICLIENT apiclient

<h3>Seleccionar Bonos de Bocadillos</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errores: @errors</p>
    </div>
    <div class="row">
        <div class="col-10">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Nombre</span>
                        <input type="text" id="inputNombre" @bind="bonoNombre" class="form-control" placeholder="Nombre" aria-label="Nombre" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon2">Tipo</span>
                        <input type="text" id="inputTipo" @bind="tipoSelected" class="form-control" placeholder="Tipo de bocadillo" aria-label="Tipo" aria-describedby="basic-addon2">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick="@BuscarBonos" id="searchBonos">Buscar bonos</button>
                </div>
            </div>
            <div class="row">
                @if (isLoading)
                {
                    <p>Cargando bonos....</p>
                }
                else if (Bonos == null || Bonos.Count == 0)
                {
                    <p><em>No hay bonos disponibles</em></p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfBonos">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tipo</th>
                                    <th>Nº Bocadillos</th>
                                    <th>Precio</th>
                                    <th>Stock</th>
                                    <th>Añadir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bono in Bonos)
                                {
                                    var cantidadEnCarrito = CantidadEnCarrito(bono.BonoId);
                                    var stockDisponible = bono.CantidadDisponible - cantidadEnCarrito;
                                    var botonDeshabilitado = stockDisponible <= 0;

                                    <tr id="BonoData_@bono.BonoId">
                                        <td>@bono.Nombre</td>
                                        <td>@bono.TipoBocadillo</td>
                                        <td>@bono.NBocadillos</td>
                                        <td>@bono.PVP.ToString("F2") €</td>
                                        <td>@bono.CantidadDisponible</td>
                                        <td>
                                            <button class="btn btn-outline-secondary"
                                                    id="bonoToAdd_@bono.BonoId"
                                                    @onclick="@(() => AddBono(bono))"
                                                    disabled="@botonDeshabilitado">
                                                Añadir
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-2" hidden="@hideCarrito">
            <div class="row">
                <h3>Carrito</h3>
            </div>
            @foreach (BonosCompradosDTO item in compra.BonoItem)
            {
                <div class="row mb-2">
                    <div class="col">
                        <div class="card">
                            <div class="card-body p-2">
                                <button type="button" class="btn-close float-end" aria-label="Close"
                                        id="removeBono_@item.Nombre"
                                        @onclick="@(() => RemoveBonoItem(item))"></button>
                                <h6 class="card-title">@item.Nombre</h6>
                                <p class="card-text mb-1">
                                    <small class="text-muted">
                                        Cantidad: @item.Cantidad<br />
                                        @item.PrecioUnitario.ToString("F2")€ c/u
                                    </small>
                                </p>
                                <p class="card-text mb-0">
                                    <strong>@((item.PrecioUnitario * item.Cantidad).ToString("F2"))€</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="row mt-3">
                <div class="col">
                    <div class="card bg-light">
                        <div class="card-body p-2">
                            <h6 class="mb-1">Total</h6>
                            <h4 class="mb-0">@CalcularTotal()€</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col">
                    <button type="button" class="btn btn-primary w-100" id="ComprarBonos" @onclick="@ComprarBonos">
                        Comprar bonos
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string tipoSelected = string.Empty;
    private ICollection<string>? tiposNombres = new List<string>();
    private bool hideCarrito { get { return compra.BonoItem.Count == 0; } }
    private ICollection<AppForSEII2526.API.ComprarBonoBocadilloDTOs.BonoSelectDTO>? Bonos;
    private List<AppForSEII2526.API.ComprarBonoBocadilloDTOs.BonoSelectDTO> TodosLosBonos { get; set; } = new List<AppForSEII2526.API.ComprarBonoBocadilloDTOs.BonoSelectDTO>();
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string bonoNombre { get; set; } = string.Empty;
    private bool isLoading = false;

    private ComprarBonoBocadilloPost compra => bonoState.Compra;

    protected override void OnInitialized()
    {
        bonoState.OnChange += StateHasChanged;
    }

    private void AddBono(AppForSEII2526.API.ComprarBonoBocadilloDTOs.BonoSelectDTO bono)
    {
        var cantidadEnCarrito = CantidadEnCarrito(bono.BonoId);

        // Verificar que no se exceda el stock disponible
        if (cantidadEnCarrito >= bono.CantidadDisponible)
        {
            errors = $"No puedes añadir más unidades de '{bono.Nombre}'. Stock disponible: {bono.CantidadDisponible}";
            return;
        }

        // Añadir solo 1 unidad al carrito
        bonoState.AgregarBono(bono);
        errors = "";
    }

    private void RemoveBonoItem(BonosCompradosDTO item)
    {
        var bonoSelect = TodosLosBonos.FirstOrDefault(b => b.BonoId == item.BonoID);
        if (bonoSelect != null)
        {
            bonoState.EliminarBono(bonoSelect);
        }
    }

    private int CantidadEnCarrito(int bonoId)
    {
        return compra?.BonoItem.FirstOrDefault(b => b.BonoID == bonoId)?.Cantidad ?? 0;
    }

    private string CalcularTotal()
    {
        double total = compra?.BonoItem.Sum(item => item.PrecioUnitario * item.Cantidad) ?? 0;
        return total.ToString("F2");
    }

    public async void BuscarBonos()
    {
        string? tipoFiltro = string.IsNullOrWhiteSpace(tipoSelected) ? null : tipoSelected;
        string? nombreFiltro = string.IsNullOrWhiteSpace(bonoNombre) ? null : bonoNombre;

        isLoading = true;
        try
        {
            // Llamar a la API con los filtros
            var bonosFromApi = await apiclient.GetBonoParaCompraAsync(nombreFiltro, tipoFiltro);

            // Mapear de ComprarBonosDTO a BonoSelectDTO
            TodosLosBonos = bonosFromApi.Select(b => new AppForSEII2526.API.ComprarBonoBocadilloDTOs.BonoSelectDTO
            {
                BonoId = b.BonoID,
                Nombre = b.Nombre ?? string.Empty,
                PVP = b.PrecioDeLaCompra,
                NBocadillos = b.Cantidad,
                TipoBocadillo = b.Tipo ?? string.Empty,
                CantidadDisponible = b.Cantidad
            }).ToList();

            Bonos = TodosLosBonos;
            errors = "";

            logger.LogInformation($"Se cargaron {TodosLosBonos.Count} bonos desde la API");
        }
        catch (ApiException ex)
        {
            TodosLosBonos = new List<AppForSEII2526.API.ComprarBonoBocadilloDTOs.BonoSelectDTO>();
            Bonos = TodosLosBonos;
            logger.LogError(ex, "Error al cargar bonos desde la API");
            errors = "Error al conectar con el sistema";
        }
        finally
        {
            isLoading = false;
        }

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        BuscarBonos();
    }

    private void ComprarBonos()
    {
        navigation.NavigateTo("/bonos/PostBonoBocadillo");
    }

    public void Dispose()
    {
        bonoState.OnChange -= StateHasChanged;
    }
}